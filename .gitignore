# Môi trường Python
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Dữ liệu sinh ra khi chạy (chỉ thư mục ở gốc repo; xem chú thích dưới)
# Phải có dấu "/" đầu: mẫu "data/" không có dấu đầu sẽ khớp ở MỌI độ sâu,
# tức là nuốt luôn tests/data/ — nơi spec §9 bắt buộc chứa video mẫu và
# expected.json. Ghi "/data/" để chỉ chặn dữ liệu runtime ở gốc.
/data/
*.db
*.db-journal
*.log
# File runtime ở gốc repo. Có dấu "/" đầu để không nuốt fixture trùng tên
# nằm trong tests/ (ví dụ tests/data/calibration.json nếu sau này có).
/calibration.json
/out.json

# Ultralytics tự tạo khi predict/export (ảnh overlay, log, weight trung gian)
runs/

# Thư mục nháp kiểm chứng ở gốc repo (ảnh overlay, khung hình chụp lại)
# Có dấu "/" đầu: chỉ chặn ở gốc, không khớp thư mục con trùng tên.
/out/
/artifacts/

# Model và file export (lớn, không nên commit)
*.pt
*.onnx
*_ncnn_model/
models/

# Cấu hình cá nhân (giữ config.yaml mẫu trong repo)
config.local.yaml

# Công cụ Python sinh ra khi chạy test/đóng gói
.coverage
htmlcov/
.tox/
.nox/
build/
dist/

# File rác do Paseo tự sinh, nội dung rỗng {}
paseo.json

# Editor / OS
*.swp
*~
*.bak
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Lưới an toàn (phải nằm CUỐI file, sau mọi mẫu loại trừ): spec §9 và §13
# bắt buộc commit video mẫu + expected.json. Negation chỉ hiệu lực vì thư mục
# cha tests/ không bị loại trừ — "/data/" không khớp "tests/data/".
!tests/data/**
