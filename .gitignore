# =============================================================================
# 1. Môi trường Python & đóng gói
# =============================================================================
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# =============================================================================
# 2. Dữ liệu runtime, cấu hình cá nhân & triển khai (KHÔNG commit bí mật)
# =============================================================================
# Dấu "/" đầu bắt buộc để chỉ chặn ở gốc repo, không nuốt tests/data/.
/data/
/out/
/artifacts/
/calibration.json
/out.json
config.local.yaml
*.db
*.db-journal
*.log
runs/

# Kịch bản triển khai cá nhân (chứa thông tin nhạy cảm)
/.deploy/
/test.py

# =============================================================================
# 3. Trọng số mô hình AI (lớn, chỉ giữ khung thư mục models/.gitkeep)
# =============================================================================
*.pt
*.onnx
*_ncnn_model/
/models/*
!/models/.gitkeep

# =============================================================================
# 4. Sandbox, cache kiểm thử & thư mục nháp của công cụ tự động
# =============================================================================
/.pytest-*/
/pytest-of-*/
/tmp*/
/torchinductor_*/
/.w[0-9]*/
/probe*/
/zz*/
/fresh-*/
/.scratch/
/.live-shot/
/.agent-teams/
/.preserved-worktrees/
/.npm-cache/
paseo.json

# =============================================================================
# 5. Tài liệu xuất tự động, trình soạn thảo & hệ điều hành
# =============================================================================
~$*
/BaoCao/*.docx
*.swp
*~
*.bak
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# =============================================================================
# 6. Lưới an toàn (luôn đặt CUỐI file để bảo vệ dữ liệu mẫu kiểm thử)
# =============================================================================
!tests/data/**
