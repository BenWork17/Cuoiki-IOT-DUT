{
  "name": "posture-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --import ./test/register-ts.mjs --test --test-isolation=none \"test/*.test.mjs\"",
    "verify": "node --import ./test/register-ts.mjs --test --test-isolation=none \"test/ui/*.test.mjs\"",
    "verify:all": "npm run test && npm run verify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.24",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-modules-commonjs": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@types/react": "~19.3.0",
    "jsdom": "^29.1.1",
    "react-dom": "19.3.0",
    "react-native-web": "~0.21.0",
    "typescript": "~6.0.3"
  }
}
